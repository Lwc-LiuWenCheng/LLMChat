<Project>

  <!-- 集中管理包版本（Directory.Build.props 的 ManagePackageVersionsCentrally）。
       版本均已在 .NET 10.0.403 + net10.0 上实测可还原、可编译。 -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <!-- 无显示器冒烟测试：headless 平台（真实 dispatcher + 绘制桩），不需要 X server。 -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup Label="Storage">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
