<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rendering="using:Chat.App.Rendering"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="760"
        x:Class="Chat.App.Views.MainWindow"
        Title="LLMChat"
        Width="1080"
        Height="760"
        Background="#17181C">
  <Window.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8B909A" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.msg">
      <Setter Property="Background" Value="#1E1F24" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.msg.user">
      <Setter Property="Background" Value="#233047" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9BA1AC" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type rendering:MarkdownHeading}">
      <rendering:MarkdownHeadingPresenter InlinesSource="{Binding Inlines}" Level="{Binding Level}" Margin="0,6,0,2" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type rendering:MarkdownParagraph}">
      <rendering:MarkdownParagraphPresenter InlinesSource="{Binding Inlines}" Margin="0,2" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type rendering:MarkdownCodeBlock}">
      <Border Background="#1B1C21" CornerRadius="6" Padding="10" Margin="0,4">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <SelectableTextBlock Text="{Binding Code}"
                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                               FontSize="12"
                               TextWrapping="NoWrap" />
        </ScrollViewer>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type rendering:MarkdownList}">
      <ItemsControl ItemsSource="{Binding Items}" Margin="0,2">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding Marker}" Classes="muted" Margin="0,2,6,0" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Blocks}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <DataTemplate DataType="{x:Type rendering:MarkdownQuote}">
      <Border BorderBrush="#3A3B42" BorderThickness="3,0,0,0" Padding="10,0,0,0" Margin="0,4">
        <ItemsControl ItemsSource="{Binding Blocks}" />
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type rendering:MarkdownTable}">
      <rendering:MarkdownTablePresenter Rows="{Binding Rows}" HasHeader="{Binding HasHeader}" Margin="0,4" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type rendering:MarkdownThematicBreak}">
      <Border Height="1" Background="#2A2B31" Margin="0,8" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type rendering:MarkdownHtml}">
      <SelectableTextBlock Text="{Binding Text}" Classes="muted" TextWrapping="Wrap" />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="0" Background="#1B1C21" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
          <TextBlock Text="LLMChat" Classes="title" />
          <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" />
          <Button Content="新建会话"
                  Command="{Binding NewSessionCommand}"
                  HorizontalAlignment="Stretch"
                  Margin="0,6,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
            <Button x:Name="ImportButton"
                    Content="导入备份…"
                    Click="OnImportArchiveClicked"
                    Classes="ghost" />
            <Button x:Name="ExportCurrentButton"
                    Content="导出当前…"
                    Click="OnExportCurrentClicked"
                    Classes="ghost"
                    IsEnabled="{Binding !ShowEmptyState}" />
            <Button x:Name="ExportAllButton"
                    Content="导出全部…"
                    Click="OnExportAllClicked"
                    Classes="ghost" />
          </StackPanel>
        </StackPanel>

        <TextBox DockPanel.Dock="Top"
                 x:Name="SearchBox"
                 Text="{Binding SearchText}"
                 PlaceholderText="搜索会话（标题或首条消息）"
                 Margin="0,0,0,8" />

        <Expander DockPanel.Dock="Bottom"
                  x:Name="SettingsExpander"
                  Header="设置"
                  IsExpanded="{Binding IsSettingsOpen}"
                  Margin="0,10,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="DeepSeek API Key" Classes="muted" />
            <TextBox Text="{Binding ApiKeyInput}" PasswordChar="•" PlaceholderText="sk-..." />
            <Button Content="保存" Command="{Binding SaveSettingsCommand}" Classes="accent" />
            <TextBlock Text="Key 保存在本地设置库；环境变量 DEEPSEEK_APIKEY 作为兜底。"
                       Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Expander>

        <Border DockPanel.Dock="Top"
                x:Name="ImportPanel"
                IsVisible="{Binding IsArchivePanelVisible}"
                Background="#23252B"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,8">
          <StackPanel Spacing="6">
            <TextBlock Text="导入 / 导出" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ArchiveStatusText}"
                       Classes="muted"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ArchiveConfirmationText}"
                       IsVisible="{Binding IsArchiveConfirmVisible}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsArchiveConfirmVisible}">
              <Button Content="确认导入"
                      Command="{Binding ConfirmImportCommand}"
                      Classes="accent" />
              <Button Content="取消"
                      Command="{Binding CancelImportCommand}"
                      Classes="ghost" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsArchiveBusy}">
              <ProgressBar IsIndeterminate="True" />
              <Button Content="取消操作"
                      Command="{Binding CancelArchiveOperationCommand}"
                      Classes="ghost"
                      HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock x:Name="ArchiveSummaryBlock"
                       Text="{Binding ArchiveSummaryText}"
                       IsVisible="{Binding HasArchiveSummary}"
                       TextWrapping="Wrap"
                       Foreground="#9BA1AC" />
            <Button x:Name="CloseArchiveSummaryButton"
                    Content="关闭摘要"
                    Command="{Binding ClearArchiveSummaryCommand}"
                    Classes="ghost"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding HasArchiveSummary}" />
          </StackPanel>
        </Border>

        <ListBox x:Name="SessionsList"
                 ItemsSource="{Binding Sessions}"
                 SelectedItem="{Binding SelectedSession}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}" Classes="muted" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="置顶"
                           Classes="muted"
                           IsVisible="{Binding Pinned}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Padding="16,12" Background="#1B1C21">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="SessionTitle"
                         Text="{Binding SelectedSession.DisplayTitle, FallbackValue=新会话}"
                         Classes="title"
                         VerticalAlignment="Center"
                         DoubleTapped="OnTitleDoubleTapped" />
              <Button Content="重命名"
                      Command="{Binding BeginRenameCommand}"
                      Classes="ghost"
                      IsVisible="{Binding !ShowEmptyState}" />
              <Button Content="置顶"
                      Command="{Binding TogglePinCommand}"
                      Classes="ghost"
                      IsVisible="{Binding !ShowEmptyState}" />
              <Button Content="删除"
                      Command="{Binding RequestDeleteSessionCommand}"
                      Classes="ghost"
                      IsVisible="{Binding !ShowEmptyState}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsRenaming}">
              <TextBox x:Name="RenameBox" Text="{Binding RenameText}" Width="220" />
              <Button Content="保存" Command="{Binding CommitRenameCommand}" Classes="accent" />
              <Button Content="取消" Command="{Binding CancelRenameCommand}" Classes="ghost" />
            </StackPanel>

            <TextBlock Text="双击标题或点「重命名」修改名称。"
                       Classes="muted"
                       IsVisible="{Binding !ShowEmptyState}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Grid.Row="0"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Top">
            <TextBlock Text="{Binding BranchText}"
                       Classes="muted"
                       VerticalAlignment="Center"
                       IsVisible="{Binding CanNavigateBranch}" />
            <Button Content="‹" Command="{Binding PrevBranchCommand}" Classes="ghost" IsVisible="{Binding CanNavigateBranch}" />
            <Button Content="›" Command="{Binding NextBranchCommand}" Classes="ghost" IsVisible="{Binding CanNavigateBranch}" />
            <ComboBox x:Name="ProvidersCombo"
                      ItemsSource="{Binding Providers}"
                      SelectedItem="{Binding SelectedProvider}"
                      DisplayMemberBinding="{Binding DisplayName}"
                      Width="170" />
            <TextBox Text="{Binding Model}" Width="150" PlaceholderText="模型" />
            <Button Content="重新生成" Command="{Binding RegenerateCommand}" Classes="ghost" />
          </StackPanel>

          <Border Grid.Row="1" Grid.ColumnSpan="2"
                  IsVisible="{Binding IsDeleteConfirmVisible}"
                  Background="#3A1F24"
                  CornerRadius="6"
                  Padding="10"
                  Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="删除这个会话？删除后可在数据库中恢复。" VerticalAlignment="Center" />
              <Button Content="确认删除" Command="{Binding ConfirmDeleteSessionCommand}" Classes="accent" />
              <Button Content="取消" Command="{Binding CancelDeleteSessionCommand}" Classes="ghost" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" x:Name="MessageScroll" Padding="16,12">
        <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="msg" Classes.user="{Binding IsUser}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding RoleText}" Classes="muted" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Foreground="#E6A23C"
                               FontSize="12"
                               IsVisible="{Binding ShowStatus}" />
                  </Grid>

                  <Expander IsVisible="{Binding HasThinking}"
                            IsExpanded="{Binding IsThinkingExpanded}"
                            Header="{Binding ThinkingHeader}">
                    <SelectableTextBlock Text="{Binding Thinking}"
                                         TextWrapping="Wrap"
                                         Foreground="#9BA1AC" />
                  </Expander>

                  <ItemsControl ItemsSource="{Binding Blocks}" IsVisible="{Binding IsAssistant}" />
                  <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding IsUser}" />

                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="复制"
                            Classes="ghost"
                            Command="{Binding $parent[Window].DataContext.CopyMessageCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="编辑"
                            Classes="ghost"
                            IsVisible="{Binding IsUser}"
                            Command="{Binding $parent[Window].DataContext.BeginEditCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="重新生成"
                            Classes="ghost"
                            IsVisible="{Binding IsAssistant}"
                            Command="{Binding $parent[Window].DataContext.RegenerateMessageCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="重试"
                            Classes="ghost"
                            IsVisible="{Binding CanRetry}"
                            Command="{Binding $parent[Window].DataContext.RetryMessageCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="1"
              x:Name="EmptyState"
              IsVisible="{Binding ShowEmptyState}"
              Background="#17181C">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="440">
          <TextBlock Text="开始一段新对话" Classes="title" HorizontalAlignment="Center" />
          <TextBlock Text="在左侧新建会话，或直接在下方输入消息。"
                     Classes="muted"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <TextBlock Text="没有可用的模型插件：请把插件构建产物放到 plugins/ 目录，或检查启动日志。"
                     Foreground="#E6A23C"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     IsVisible="{Binding ShowNoPlugins}" />
          <Button Content="新建会话"
                  Command="{Binding NewSessionCommand}"
                  Classes="accent"
                  HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="#1B1C21" Padding="16,12">
        <StackPanel Spacing="8">
          <Border x:Name="ErrorBar"
                  IsVisible="{Binding HasError}"
                  Background="#3A1F24"
                  CornerRadius="6"
                  Padding="10,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ErrorText}"
                         TextWrapping="Wrap"
                         Foreground="#F08A8A"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="×" Command="{Binding DismissErrorCommand}" Classes="ghost" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="Composer"
                     Text="{Binding Composer}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="66"
                     MaxHeight="180"
                     IsEnabled="{Binding CanEditComposer}"
                     PlaceholderText="输入消息…（Enter 发送，Shift+Enter 换行）" />
            <StackPanel Grid.Column="1" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Bottom">
              <Button x:Name="SendButton"
                      Content="发送"
                      Command="{Binding SendCommand}"
                      Classes="accent"
                      IsVisible="{Binding ShowSend}"
                      MinWidth="80" />
              <Button x:Name="StopButton"
                      Content="停止"
                      Command="{Binding StopCommand}"
                      IsVisible="{Binding ShowStop}"
                      MinWidth="80" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Enter 发送，Shift+Enter 换行；生成中可点「停止」，停止后消息标记为「已停止」。"
                     Classes="muted" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>