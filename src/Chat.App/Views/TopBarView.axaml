<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:abstractions="using:Chat.Abstractions"
             xmlns:vm="using:Chat.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="56"
             d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
             x:Class="Chat.App.Views.TopBarView">
  <!-- 顶栏：汉堡菜单 / 标题 / 模型 / 新建对话 / 主题 / 窗口按钮 -->
  <Border Background="#1B1C21"
          BorderBrush="#2A2B31"
          BorderThickness="0,0,0,1"
          Padding="12,0"
          Height="56">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <!-- 汉堡；会话标题由 SukiWindow 原生标题栏显示，避免两行标题。 -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button x:Name="HamburgerButton"
                Content="☰"
                Classes="ghost"
                FontSize="18"
                Click="OnHamburgerClicked"
                ToolTip.Tip="展开 / 收起侧边栏" />
      </StackPanel>

      <!-- 当前模型 / 供应商：只显示下拉（内含 DisplayName），避免与 Model 文本重复两处。 -->
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <ComboBox ItemsSource="{Binding Providers}"
                  SelectedItem="{Binding SelectedProvider}"
                  Width="150"
                  FontSize="12"
                  MaxHeight="32">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="{x:Type abstractions:ProviderDescriptor}">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- 全局操作与窗口控制 -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Content="＋ 新建对话"
                Command="{Binding NewSessionCommand}"
                Classes="accent"
                FontSize="12" />
        <Button Content="◐"
                Classes="ghost"
                FontSize="16"
                Click="OnToggleThemeClicked"
                ToolTip.Tip="切换明暗主题" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
