<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 复用 /srv/workspace 工作区已有的 .NET 10 SDK 与 NuGet 缓存：
       不重复下载 SDK；已缓存过的包（xunit.v3 等）直接命中。 -->
  <config>
    <add key="globalPackagesFolder" value="/srv/workspace/env/cache/nuget" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
